<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/btnBack"
            style="@style/TopBtn"
            android:text="@string/back"/>

        <TextView
            android:id="@+id/tvSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/exportRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/chipContainer"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="6dp">

        <TextView
            android:id="@+id/btnExpTxt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:padding="7dp"
            android:text="@string/exp_txt"
            android:textColor="@color/primaryDark"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/btnExpDoc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:padding="7dp"
            android:text="@string/exp_doc"
            android:textColor="@color/primaryDark"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/btnExpPdf"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:padding="7dp"
            android:text="@string/exp_pdf"
            android:textColor="@color/primaryDark"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <EditText
        android:id="@+id/etSearch"
        style="@style/FieldStyle"
        android:layout_margin="10dp"
        android:background="@drawable/bg_search"
        android:hint="@string/search_hint"
        android:inputType="text"
        android:maxLines="1"/>

    <WebView
        android:id="@+id/printView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="2dp"
            android:paddingBottom="86dp"
            android:scrollbars="none"/>

        <LinearLayout
            android:id="@+id/emptyBox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗂️"
                android:textSize="38sp"/>

            <TextView
                android:id="@+id/tvEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/empty_records"
                android:textColor="@color/textSub"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvEmptySub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/empty_records_sub"
                android:textColor="@color/hint"
                android:textSize="12sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/fab"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="14dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_fab"
            android:elevation="6dp"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/white"
            android:textSize="26sp"/>
    </FrameLayout>
</LinearLayout>
